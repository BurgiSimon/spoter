# ── Required ────────────────────────────────────────────────────────────────
# Public URL of your instance (used for OAuth redirects and cookies).
# Locally use http://127.0.0.1:3000 (Spotify no longer accepts "localhost").
APP_URL=http://127.0.0.1:3000

# 32 random bytes, base64. Encrypts Spotify tokens and signs OAuth state.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Postgres. docker-compose builds DATABASE_URL from POSTGRES_PASSWORD for you.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://spoter:change-me@127.0.0.1:5432/spoter

# ── Recommended ─────────────────────────────────────────────────────────────
# Last.fm API key (free, https://www.last.fm/api/account/create). Adds
# track-level tags, similar tracks and tag charts. Without it Spoter falls back
# to MusicBrainz, ListenBrainz and Deezer, which work but are less precise.
LASTFM_API_KEY=

# ── Optional: Spotify login & sync ──────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard, select "Web API",
# and add the redirect URI: <APP_URL>/api/auth/spotify/callback
# Development Mode apps are limited to 5 allow-listed users and the owner needs
# Spotify Premium. Everyone else can still use the data-export upload.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Tuning ──────────────────────────────────────────────────────────────────
# Set to false to stop new email sign-ups (Spotify login still works for allow-listed users).
ALLOW_REGISTRATION=true
# Concurrent per-user pipelines in one worker process.
WORKER_CONCURRENCY=2
LOG_LEVEL=info
# Where users can get the source code of this instance (AGPL-3.0 §13). Change it if you modify Spoter.
SOURCE_URL=https://github.com/BurgiSimon/spoter
